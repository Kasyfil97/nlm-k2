# Salin ke deploy.env lalu isi. deploy.env tidak boleh di-commit (ada di .gitignore).

# --- Nexus registry (wajib) ---
NEXUS_USERNAME=""
NEXUS_PASSWORD=""
NEXUS_EMAIL=""

# --- Alamat lingkungan: mengisi placeholder di k8s/*/configmap.yaml ---
# Host yang boleh dipakai file_url (presigned MinIO), dipisah koma. Kosong = semua file_url internal ditolak.
FILE_URL_ALLOWED_HOSTS=""

# --- Secret aplikasi: dibuat sebagai Secret ms-bribrain-nilam-ocr-kk-secrets ---
# Kalau API_KEY dan DATABASE_URL dikosongkan, Secret itu harus sudah ada di cluster.
API_KEY=""
# Format SQLAlchemy, bukan JDBC; karakter khusus di password di-URL-encode (@ jadi %40).
DATABASE_URL="postgresql+asyncpg://<user>:<password>@<host>:5432/nilam"
# Opsional
API_KEYS=""
ORCHESTRATION_API_KEY=""
# Kunci server PaddleOCR (service ms-bribrain-nilam-ocr-paddle-ppocr-v6-service); dipakai extraction.
EXTRACTION_OCR_API_KEY=""
# Token APM Server (Elastic APM), dari pengelola APM; tanpa ini data APM tidak masuk (401).
ELASTIC_APM_SECRET_TOKEN=""

# --- Opsional: timpa konfigurasi cluster di deploy.sh ---
# PROJECT_ID="shared-kubecluster-dev-01"
# CLUSTER_NAME="gc-bigpool-dev-gke-cluster-01"
# REGION="asia-southeast2"
# NAMESPACE="bribrain-ocr-nilam"
# DEFAULT_TAG="1.0.0"
