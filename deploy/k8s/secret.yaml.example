# Salin ke secret.yaml, isi nilainya, lalu: kubectl apply -f secret.yaml
# Secret ini muncul di Rancher: cluster > Storage > Secrets, namespace bribrain-ocr-nilam.
# secret.yaml berisi rahasia dan tidak boleh di-commit (ada di .gitignore).
apiVersion: v1
kind: Secret
metadata:
  name: ms-bribrain-nilam-ocr-kk-secrets
  namespace: bribrain-ocr-nilam
  labels:
    app.kubernetes.io/part-of: ms-bribrain-nilam-ocr-kk
type: Opaque
stringData:
  # Wajib
  API_KEY: ""
  # Format SQLAlchemy, bukan JDBC; karakter khusus di password di-URL-encode (@ jadi %40).
  DATABASE_URL: "postgresql+asyncpg://<user>:<password>@<host>:5432/nilam"
  # Wajib untuk extraction (kunci server PaddleOCR ms-bribrain-nilam-ocr-paddle-ppocr-v6-service)
  EXTRACTION_OCR_API_KEY: ""
  # Opsional: hapus barisnya kalau tidak dipakai
  # API_KEYS: ""
  # Token APM Server (Elastic APM); tanpa ini APM Server menolak (401), service tetap jalan
  # ELASTIC_APM_SECRET_TOKEN: ""
