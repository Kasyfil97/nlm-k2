# Konfigurasi tracker, di-source oleh run.sh dan stop.sh.
#
# Komentari SELURUH blok GKE di bawah untuk kembali ke stack lokal:
# app.py otomatis jatuh ke default 127.0.0.1:8040-8044 tanpa API key, dan
# callback datang langsung dari container seperti biasa. "Tanpa API key" berarti
# kelima service lokal (termasuk orchestrator) harus AUTH_DISABLED=true di
# services/<nama>/.env.local (sudah begitu bawaannya); kalau tidak, isi API_KEY
# di luar blok GKE dengan API_KEY service lokal.

# ── GKE: gc-ddb-dev-gke-cluster-01 / namespace nlm-k2 ─────────────────────────
# TRACKER_TARGET=gke
# GKE_NAMESPACE=nlm-k2
# Chart deploy/helm/nlm-k2 (Deployment per service, termasuk orchestrator): port-forward ke svc/<GKE_RELEASE>-<service>.
# GKE_RELEASE=nilam-ocr-kk
# ORCHESTRATOR_URL=http://127.0.0.1:9040
# GUARDRAILS_URL=http://127.0.0.1:9041
# EXTRACTION_URL=http://127.0.0.1:9042
# STRUCTURING_URL=http://127.0.0.1:9043
# SCORING_URL=http://127.0.0.1:9044
# API_KEY service di dev (service memaksa X-API-Key); jangan di-commit.
# API_KEY=
# TRACKER_POLL=1
# ────────────────────────────────────────────────────────────────────────────

# Redis tetap lokal di kedua mode; tracker memakainya sebagai bus event.
REDIS_URL=redis://127.0.0.1:6379/0

# Pemantau outbox: tracker membaca nilam_pipeline_outbox dan nilam_<tahap>_jobs (schema nilam_ocr_kk) langsung
# dari PostgreSQL tiap 250 ms. Mode lokal: otomatis ke Postgres docker-compose.db.yml
# (127.0.0.1:${POSTGRES_HOST_PORT:-5433}). Mode GKE: isi sendiri kalau database
# dev bisa dijangkau dari laptop; kosong = panel outbox hanya bilang "tidak tersedia".
# TRACKER_DATABASE_URL=postgresql://postgres:changeme@127.0.0.1:5433/bribrain_ocr_kk

# Sama dengan PIPELINE_WAIT_SECONDS di orchestrator (bawaan 30); hanya untuk label di UI.
TRACKER_WAIT_SECONDS=30

# ── Skenario gangguan (mode lokal) ──
# Container compose bernama <COMPOSE_PROJECT_NAME>-<service>-1 (nlm-k2-orchestrator-1, ...). Isi kalau stack
# dijalankan dengan nama proyek lain (mis. COMPOSE_PROJECT_NAME=nlm-k2-b di .env akar repo).
# TRACKER_CONTAINER_PREFIX=nlm-k2-
# TRACKER_CONTAINER_SUFFIX=-1
# Samakan dengan env service; lease pendek membuat skenario crash / database selesai dalam ~1 menit.
# TRACKER_JOB_LEASE_SECONDS=30
# TRACKER_STALE_JOB_INTERVAL_SECONDS=5
# TRACKER_DRAIN_SECONDS=30
# TRACKER_STOP_GRACE_SECONDS=45
# Callback format result (/v1/ocr-callback): periksa X-Callback-Key seperti Orkestrasi pusat.
# TRACKER_CALLBACK_KEY=local-callback-key
# TRACKER_CALLBACK_SLOW_SECONDS=12
# TRACKER_CALLBACK_FLAKY_FAILURES=2

# ── Load testing ──
# Network compose tempat k6 berjalan (<COMPOSE_PROJECT_NAME>_default) dan alamat orchestrator di dalamnya.
# K6_NETWORK=nlm-k2_default
# K6_TARGET=http://orchestrator:8040
# Contoh dokumen uji yang ikut repo; bawaannya test/data (dibaca saja, tidak pernah dihapus dari tracker).
# LOAD_TESTER_SAMPLES_DIR=
