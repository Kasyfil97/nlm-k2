    {
      "name": "Extract OCR",
      "description": "Happy paths. Set `apiKey` in the environment. Attach a Kartu Keluarga JPEG/PNG/PDF (<= 10 MB, <= 2 pages) to `file`. Run POST before GET: GET reads the `requestId` the POST set.",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('envelope has all keys', () => {",
              "  const b = pm.response.json();",
              "  ['status_code','status_desc','message','data','errors','request_id'].forEach(k => pm.expect(b).to.have.property(k));",
              "});",
              "pm.test('status_code equals HTTP status', () => {",
              "  pm.expect(pm.response.json().status_code).to.eql(pm.response.code);",
              "});"
            ]
          }
        }
      ],
      "item": [
        {
          "name": "POST /v1/extract-ocr (file upload)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/extract-ocr",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "extract-ocr"
              ]
            },
            "description": "The call the central orchestrator makes. Full pipeline; waits up to PIPELINE_WAIT_SECONDS (30 s default).",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "request_id",
                  "value": "{{requestId}}",
                  "type": "text"
                },
                {
                  "key": "file",
                  "type": "file",
                  "src": []
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Each POST gets a fresh request_id; the GET requests read it back via {{requestId}}.",
                  "pm.collectionVariables.set('requestId', 'OCR_' + pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('envelope has all keys', () => {",
                  "  const b = pm.response.json();",
                  "  ['status_code','status_desc','message','data','errors','request_id'].forEach(k => pm.expect(b).to.have.property(k));",
                  "});",
                  "pm.test('status_code equals HTTP status', () => {",
                  "  pm.expect(pm.response.json().status_code).to.eql(pm.response.code);",
                  "});",
                  "pm.test('200 finished or 202 still running', () => {",
                  "  pm.expect([200, 202]).to.include(pm.response.code);",
                  "});",
                  "pm.test('200: nine fields as {value, confidence}; 202: data is null', () => {",
                  "  const b = pm.response.json();",
                  "  if (pm.response.code === 202) { pm.expect(b.data).to.eql(null); return; }",
                  "  const d = b.data;",
                  "  pm.expect(d).to.have.keys(['no_kk','nama_kepala_keluarga','anggota_keluarga']);",
                  "  ['no_kk','nama_kepala_keluarga'].forEach(k => pm.expect(d[k]).to.have.keys(['value','confidence']));",
                  "  pm.expect(d.anggota_keluarga).to.be.an('array');",
                  "  d.anggota_keluarga.forEach(m => pm.expect(m).to.have.keys(['nama_lengkap','nik','pendidikan','jenis_pekerjaan','status_hubungan_dalam_rumah_tangga','ayah','ibu']));",
                  "});",
                  "pm.test('pipeline_last_stage is null on success', () => {",
                  "  pm.expect(pm.response.json().pipeline_last_stage).to.eql(null);",
                  "});"
                ]
              }
            }
          ]
        },
