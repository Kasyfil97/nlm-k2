API_KEY=changeme

ENVIRONMENT=local
# AUTH_DISABLED=false

# SERVICE_BASE_URL=http://your-vm-ip:8040
# PORT=8040

# Guardrails: setiap dokumen dinilai di sini dulu (POST /v1/guardrails/check).
# GUARDRAILS_SERVICE_URL=http://127.0.0.1:8041
# GUARDRAILS_API_KEY=
# GUARDRAILS_TIMEOUT_SECONDS=20
# Tanpa `guardrails` di pipeline_name_sequence request melewati model ini, seperti di nilam (tidak ada
# gerbang 403 lagi). Pengecekan file di bawah dan aturan structuring tetap jalan.

# Tahap OCR: dokumen yang lolos diserahkan ke sini (POST /v1/extraction/jobs).
# EXTRACTION_SERVICE_URL=http://127.0.0.1:8042
# EXTRACTION_API_KEY=
# EXTRACTION_TIMEOUT_SECONDS=10
# PIPELINE_RETRY_ATTEMPTS=3
# PIPELINE_RETRY_DELAY_SECONDS=0.5

# Database bersama, HANYA untuk mencatat setiap putusan guardrails (tabel guardrails_results, migrasi 0002),
# termasuk yang ditolak, supaya GET /v1/extract-ocr/{request_id} bisa menjawab request yang tidak pernah
# sampai tahap. Kosong = tidak ada yang dicatat. Best-effort: DB yang mati tidak menggagalkan request.
# DATABASE_URL=postgresql+asyncpg://postgres:changeme@127.0.0.1:5433/bribrain_ocr_kk
# GUARDRAILS_LOG_TIMEOUT_SECONDS=2

# Tunggu pipeline (OCR -> structuring -> scoring) selesai sebelum menjawab: 200 + hasil akhir kalau
# selesai dalam waktu ini, 202 kalau belum. Dihitung sejak request diterima. 0 = tidak menunggu (selalu 202).
PIPELINE_WAIT_SECONDS=30
# PIPELINE_POLL_INTERVAL_SECONDS=0.5
# Status tiap tahap dibaca dari sini, saat menunggu dan untuk GET /v1/extract-ocr/{request_id}.
# STRUCTURING_SERVICE_URL=http://127.0.0.1:8043
# STRUCTURING_API_KEY=
# SCORING_SERVICE_URL=http://127.0.0.1:8044
# SCORING_API_KEY=

# Ambang confidence 0/1 di data kontrak; harus sama dengan scoring.
# FIELD_CONFIDENCE_THRESHOLD=0.5

# Penjagaan file ada di sini, sebelum guardrails dipanggil.
# PDF lebih dari MAX_DOCUMENT_PAGES halaman ditolak 400 (default 2).
# MAX_DOCUMENT_PAGES=2
# Batas ukuran dokumen (default 5 MB); lebih besar ditolak 413. Nilainya ada di
# ocr_common.config.DEFAULT_MAX_UPLOAD_BYTES.
# MAX_UPLOAD_BYTES=5242880
# FILE_URL_ALLOWED_HOSTS=minio.example.internal,.storage.example.com
# ALLOWED_CONTENT_TYPES=["image/jpeg","image/jpg","image/png","application/pdf"]

# Endpoint -test untuk load test tim ML (dev saja). Jangan dinyalakan di sini: `make openapi` membaca .env
# ini, dan spec yang di-commit tidak boleh berisi route -test.
# TESTING_ENDPOINTS=false

# --- Ditambahkan fase 0 -------------------------------------------------------------------
# PDF diterima bawaan, seperti di nilam (R34a dibalik, docs/decisions/2026-09-29-selaras-nilam.md):
# lebih dari MAX_DOCUMENT_PAGES halaman ditolak 400; halaman 1 yang dinilai dan dibaca.
# MAX_DOCUMENT_PAGES=2

# Rate limit dan CORS ADA di K2Orchestrator dan didaftarkan kontrak §12, tetapi tidak ada di
# struktur yang disalin -- keduanya ditulis agen A, bukan diwarisi. Kuncinya disediakan di sini
# supaya penambahannya tidak menuntut membuka beku.
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_REQUESTS=60
# RATE_LIMIT_WINDOW_SECONDS=60
# CORS_ALLOW_ORIGINS=

# --- Elasticsearch logging ----------------------------------------------------------------
# Kirim setiap log ke Elasticsearch (non-blocking: rekam antri dan dikirim dalam batch oleh
# thread latar). ELASTICSEARCH_ENABLED=false (bawaan) mematikannya tanpa efek apa pun.
# ELASTICSEARCH_ENABLED=false
# ELASTICSEARCH_URL=http://localhost:9200
# ELASTICSEARCH_INDEX=ocr-logs
# Auth (pilih salah satu atau tidak sama sekali):
# ELASTICSEARCH_API_KEY=
# ELASTICSEARCH_USERNAME=
# ELASTICSEARCH_PASSWORD=
