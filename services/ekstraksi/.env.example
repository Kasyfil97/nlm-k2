# Placeholder yang sengaja tidak sah: service menolak start dengan nilai ini di luar
# ENVIRONMENT=local (R29), jadi deployment yang menyalin berkas ini apa adanya gagal saat start
# alih-alih berjalan dengan kunci yang bisa dibaca siapa pun di repositori.
API_KEY=changeme

ENVIRONMENT=local
# AUTH_DISABLED=false

# SERVICE_BASE_URL=http://your-vm-ip:8042
# PORT=8042

# DATABASE_URL=postgresql+asyncpg://postgres:changeme@localhost:5432/bribrain_ocr_kk

# ORCHESTRATION_URL=http://host.docker.internal:8000
# ORCHESTRATION_CALLBACK_PATH=/v1/callbacks/stage
# ORCHESTRATION_API_KEY=
# ORCHESTRATION_TIMEOUT_SECONDS=10

# PIPELINE_RETRY_ATTEMPTS=3
# PIPELINE_RETRY_DELAY_SECONDS=0.5
# PIPELINE_DRAIN_TIMEOUT_SECONDS=30
# PIPELINE_JOB_LEASE_SECONDS=300

# --- Backend OCR --------------------------------------------------------------------------
# mock | kk_ocr | remote. `mock` ditolak di luar ENVIRONMENT=local.
# EKSTRAKSI_BACKEND=mock

# `kk_ocr`: PP-OCRv5 server det + rec dalam proses ini, jalur torch K2Extractor (`fullpytorch`),
# bukan PaddleOCR native yang jadi default di sana. Bobot `.pth` tidak ikut di-commit dan pohon
# PaddleOCR2Pytorch belum ikut di image: backend ini belum bisa dijalankan, dan itu memang
# disengaja (R20a -- batch selesai dengan `mock`). Batch yang membawa bobotnya menambahkan
# torch/numpy/Pillow ke requirements.txt lalu menjalankan `make lock-ekstraksi`, yang sudah
# memuat indeks CPU PyTorch justru supaya langkah itu tidak butuh buka beku.
# EKSTRAKSI_BACKEND=kk_ocr
# EKSTRAKSI_PPOCR_ROOT=/app/ppocr
# EKSTRAKSI_DET_WEIGHTS_PATH=/app/weights/ppocrv5_server_det.pth
# EKSTRAKSI_REC_WEIGHTS_PATH=/app/weights/ppocrv5_server_rec.pth
# EKSTRAKSI_DEVICE=cpu
# Spike §7.1 menjalankan backend ini dengan nilai bawaan konstruktor dan mendapat 177 kotak yang
# sebagian besar satu karakter. Ia memvalidasi BENTUK muatan, bukan MUTU rekognisi; keempat angka
# di bawah inilah yang harus disetel ulang terhadap baseline korpus 1184 dokumen.
# EKSTRAKSI_REC_BATCH_SIZE=8
# EKSTRAKSI_REC_IMAGE_SHAPE=3,48,320
# EKSTRAKSI_DET_LIMIT_SIDE_LEN=64
# EKSTRAKSI_DET_LIMIT_TYPE=min
# 0 = bawaan torch (satu thread per core). Di node bersama, beberapa replika yang masing-masing
# mengambil semua core lebih lambat daripada masing-masing mengambil beberapa.
# EKSTRAKSI_TORCH_THREADS=0

# `remote`: model OCR yang dilayani proses lain (/v1/predict/json tim ML).
# EKSTRAKSI_BACKEND=remote
# EKSTRAKSI_OCR_URL=http://localhost:8082
# EKSTRAKSI_OCR_API_KEY=dummy-key
# EKSTRAKSI_OCR_TIMEOUT_SECONDS=30
# Hanya remote: form field tambahan ke model OCR (JSON object), mis. {"document_type": "kk"}
# EKSTRAKSI_OCR_PARAMS={}

STRUCTURING_SERVICE_URL=http://127.0.0.1:8043
# STRUCTURING_API_KEY=
# STRUCTURING_TIMEOUT_SECONDS=10

# Batas ukuran dokumen (default 5 MB); lebih besar ditolak 413. Nilainya ada di
# ocr_common.config.DEFAULT_MAX_UPLOAD_BYTES.
# MAX_UPLOAD_BYTES=5242880
# ALLOWED_CONTENT_TYPES=["image/jpeg","image/png"]

# Host yang boleh diunduh lewat `file_url`. Service ini MENGUNDUH, jadi daftarnya wajib di luar
# ENVIRONMENT=local (R18a): daftar KOSONG menolak semua URL, bukan "hanya alamat publik", sehingga
# start tanpa daftar akan meninggalkan jalur unduh yang mati. Sisa kebijakannya tidak bisa disetel
# dan tidak ditulis ulang di service ini -- `ocr_common` yang menegakkannya: skema wajib https,
# redirect tidak diikuti, dan host terdaftar yang me-resolve ke alamat privat/loopback tetap
# ditolak kecuali ia terdaftar secara harfiah (bukan lewat pola `.suffix`).
# FILE_URL_ALLOWED_HOSTS=minio.example.internal,.storage.example.com

# --- Ditambahkan fase 0 -------------------------------------------------------------------
# Jalur PDF dipertahankan tetapi mati bawaan (R34a). Ini SATU-SATUNYA cara memasukkan
# application/pdf; menambahkannya ke ALLOWED_CONTENT_TYPES dengan tangan membuat jalur setengah
# terbuka -- PDF lolos intake lalu gagal lebih dalam sebagai 422, bukan 400 yang bersih.
# PDF_ENABLED=false

# Detak job: memperbarui `updated_at` selagi job berjalan, supaya job yang sah-berjalan-lama tidak
# terlihat basi bagi reaper. `0` = mati, dan itulah bawaan batch ini -- mekanismenya dipasang
# sekarang karena kode pipeline beku setelah gerbang R6, tetapi intervalnya baru bisa disetel
# ketika durasi job sungguhan terukur. Menyalakannya MEWAJIBKAN batas atas di bawahnya.
#
# Tahap inilah yang paling membutuhkannya: backend `kk_ocr` berjalan DI DALAM proses ini, dan
# detak hanya berdetak selama `work()` melepaskan event loop. Itu sudah dijamin oleh bentuknya --
# `OcrRecognizer` sinkron dan `EkstraksiService` menaruhnya di threadpool -- dan diuji di
# tests/test_integration_handoff.py.
# PIPELINE_HEARTBEAT_SECONDS=0
# PIPELINE_JOB_MAX_RUNTIME_SECONDS=0

# Serah-terima lewat referensi: tahap berikutnya membaca hasil tahap ini dari database, bukan dari
# badan handoff. Dianjurkan untuk KK -- satu kartu menghasilkan ~180 kotak OCR, dan mode ini
# menjauhkannya dari baris outbox, termasuk dead letter yang bertahan 24 jam.
# PIPELINE_HANDOFF_BY_REFERENCE=true

# Outbox transaksional dan relaynya.
# PIPELINE_OUTBOX=true
# PIPELINE_OUTBOX_INTERVAL_SECONDS=1
# PIPELINE_OUTBOX_MAX_AGE_SECONDS=86400
# PIPELINE_STALE_JOBS=true

# Tabel outcome milik Orkestrasi pusat, di database yang sama. Kontraknya kolom `downstream_status`.
# ORCHESTRATION_OUTCOME_TABLE=orchestration_extract_ocr
# ORCHESTRATION_API_EVENTS_TABLE=

# Endpoint `-test` untuk load test tim ML; menolak menyala di luar ENVIRONMENT=local.
# TESTING_ENDPOINTS=false
