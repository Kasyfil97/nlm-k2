API_KEY=changeme

ENVIRONMENT=local
# AUTH_DISABLED=false

# SERVICE_BASE_URL=http://your-vm-ip:8042
# PORT=8042

# DATABASE_URL=postgresql+asyncpg://postgres:changeme@localhost:5432/bribrain_ocr_kk

# ORCHESTRATION_URL=http://host.docker.internal:8000
# ORCHESTRATION_CALLBACK_PATH=/v1/callbacks/stage
# ORCHESTRATION_API_KEY=
# ORCHESTRATION_TIMEOUT_SECONDS=10

# PIPELINE_RETRY_ATTEMPTS=3
# PIPELINE_RETRY_DELAY_SECONDS=0.5
# PIPELINE_DRAIN_TIMEOUT_SECONDS=30
# PIPELINE_JOB_LEASE_SECONDS=300

# EKSTRAKSI_BACKEND=mock

# EKSTRAKSI_BACKEND=remote
# EKSTRAKSI_OCR_URL=http://localhost:8082
# EKSTRAKSI_OCR_API_KEY=dummy-key

# EKSTRAKSI_BACKEND=paddle
# EKSTRAKSI_OCR_URL=http://10.213.128.67:8070

# EKSTRAKSI_OCR_TIMEOUT_SECONDS=30
# Hanya remote: form field tambahan ke model OCR (JSON object), mis. {"document_type": "npwp"}
# EKSTRAKSI_OCR_PARAMS={}

STRUCTURING_SERVICE_URL=http://127.0.0.1:8043
# STRUCTURING_API_KEY=
# STRUCTURING_TIMEOUT_SECONDS=10

# Batas ukuran dokumen (default 2,5 MB); lebih besar ditolak 413.
# MAX_UPLOAD_BYTES=2621440
# FILE_URL_ALLOWED_HOSTS=minio.example.internal,.storage.example.com
# ALLOWED_CONTENT_TYPES=["image/jpeg","image/jpg","image/png","application/pdf"]

# --- Ditambahkan fase 0 -------------------------------------------------------------------
# Jalur PDF dipertahankan tetapi mati bawaan (R34a). Ini SATU-SATUNYA cara memasukkan
# application/pdf; menambahkannya ke ALLOWED_CONTENT_TYPES dengan tangan membuat jalur setengah
# terbuka -- PDF lolos intake lalu gagal lebih dalam sebagai 422, bukan 400 yang bersih.
# PDF_ENABLED=false

# Detak job: memperbarui `updated_at` selagi job berjalan, supaya job yang sah-berjalan-lama tidak
# terlihat basi bagi reaper. `0` = mati, dan itulah bawaan batch ini -- mekanismenya dipasang
# sekarang karena kode pipeline beku setelah gerbang R6, tetapi intervalnya baru bisa disetel
# ketika durasi job sungguhan terukur. Menyalakannya MEWAJIBKAN batas atas di bawahnya.
# PIPELINE_HEARTBEAT_SECONDS=0
# PIPELINE_JOB_MAX_RUNTIME_SECONDS=0

# Serah-terima lewat referensi: tahap berikutnya membaca hasil tahap ini dari database, bukan dari
# badan handoff. Dianjurkan untuk KK -- satu kartu menghasilkan ~177 kotak OCR, dan mode ini
# menjauhkannya dari baris outbox, termasuk dead letter yang bertahan 24 jam.
# PIPELINE_HANDOFF_BY_REFERENCE=true

# Outbox transaksional dan relaynya.
# PIPELINE_OUTBOX=true
# PIPELINE_OUTBOX_INTERVAL_SECONDS=1
# PIPELINE_OUTBOX_MAX_AGE_SECONDS=86400
# PIPELINE_STALE_JOBS=true

# Tabel outcome milik Orkestrasi pusat, di database yang sama. Kontraknya kolom `downstream_status`.
# ORCHESTRATION_OUTCOME_TABLE=orchestration_extract_ocr
# ORCHESTRATION_API_EVENTS_TABLE=

# Endpoint `-test` untuk load test tim ML; menolak menyala di luar ENVIRONMENT=local.
# TESTING_ENDPOINTS=false
