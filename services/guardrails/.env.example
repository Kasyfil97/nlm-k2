API_KEY=changeme

ENVIRONMENT=local
# AUTH_DISABLED=false

# SERVICE_BASE_URL=http://your-vm-ip:8041
# PORT=8041

# Inti model K2Quality. Service ini MENOLAK START kalau salah satu dari enam artefaknya tidak ada.
# Di container, keenamnya diunduh ulang dari awalan GUARDRAILS_MODEL_URI setiap start (bukan saat build)
# dan diverifikasi terhadap model_hashes.json. Default image sudah menunjuk ke sini; isi hanya untuk
# menimpanya. Untuk lokal tanpa container:
#
#   GUARDRAILS_MODEL_URI=<direktori atau awalan gs://> make weights
GUARDRAILS_MODEL_URI=gs://gc-bribrain-dev-gcs-ocr-nilam-01/nilam-ocr-kk/guardrails/
#
# Untuk pengembangan tanpa bobot sama sekali, pakai `mock` (hanya jalan di ENVIRONMENT=local).
GUARDRAILS_BACKEND=kk_quality

# Enam artefak K2Quality dalam satu direktori: blur_cnn_weights.pt, blur_cnn_meta.json,
# xgb_model.json, calibration.json, feature_names.json, dan model_hashes.json (opsional; kalau ada,
# sha256-nya diperiksa saat start dan selisih membatalkan start).
GUARDRAILS_WEIGHTS_DIR=weights
GUARDRAILS_DEVICE=cpu
# GUARDRAILS_TORCH_THREADS=2

# GUARDRAILS_BACKEND=remote
# GUARDRAILS_MODEL_URL=http://localhost:8081
# GUARDRAILS_MODEL_API_KEY=dummy-key
# GUARDRAILS_MODEL_TIMEOUT_SECONDS=30

# --- Ambang -----------------------------------------------------------------------------------
# Tidak ada ambang yang dikonfigurasi di service ini. Hanya field `threshold` + `threshold_target` per
# request yang bisa menolak dokumen; tanpa keduanya dokumen dianggap lolos dan `probability_bad`
# dikembalikan apa adanya. GUARDRAILS_THRESHOLD dan GUARDRAILS_THRESHOLD_URL/... sudah dihapus.
#
# Catatan operasional: titik kerja K2Quality sendiri 0.85 di `config.yaml`-nya (default kodenya 0.62,
# "best F1_macro"); itulah nilai yang wajar dikirim pemanggil sebagai `threshold`.

# --- Masukan ---------------------------------------------------------------------------------
# Tipe dan ukuran (413) dicek orchestrator sebelum guardrails dipanggil. MAX_UPLOAD_BYTES di sini
# hanya membatasi unduhan file_url.
# MAX_UPLOAD_BYTES=5242880
# ALLOWED_CONTENT_TYPES=["image/jpeg","image/jpg","image/png","application/pdf"]

# PDF diterima bawaan (R34a dibalik): halaman 1 dirender 150 DPI, DPI yang sama dengan pipeline latih.

# Saklar unduh `file_url` di guardrails (§13.3, R18a). Kebijakan URL-nya sendiri sudah dipakai
# `read_image` lewat `settings.file_url_policy`; yang ditambahkan di sini hanyalah saklarnya. JANGAN
# menulis kebijakan URL kedua di service ini. Menyala di luar ENVIRONMENT=local mewajibkan
# FILE_URL_ALLOWED_HOSTS terisi, kalau tidak service menolak start.
# GUARDRAILS_FETCH_URL=false
# FILE_URL_ALLOWED_HOSTS=minio.example.internal,.storage.example.com

# --- Elasticsearch logging ----------------------------------------------------------------
# Kirim setiap log ke Elasticsearch (non-blocking: rekam antri dan dikirim dalam batch oleh
# thread latar). ELASTICSEARCH_ENABLED=false (bawaan) mematikannya tanpa efek apa pun.
# ELASTICSEARCH_ENABLED=false
# ELASTICSEARCH_URL=http://localhost:9200
# ELASTICSEARCH_INDEX=ocr-logs
# Auth (pilih salah satu atau tidak sama sekali):
# ELASTICSEARCH_API_KEY=
# ELASTICSEARCH_USERNAME=
# ELASTICSEARCH_PASSWORD=
