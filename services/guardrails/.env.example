API_KEY=changeme

ENVIRONMENT=local
# AUTH_DISABLED=false

# SERVICE_BASE_URL=http://your-vm-ip:8041
# PORT=8041

GUARDRAILS_BACKEND=kk_quality

# Enam artefak K2Quality dalam satu direktori: blur_cnn_weights.pt, blur_cnn_meta.json,
# xgb_model.json, calibration.json, feature_names.json, dan model_hashes.json (opsional; kalau ada,
# sha256-nya diperiksa saat start dan selisih membatalkan start).
GUARDRAILS_WEIGHTS_DIR=weights
GUARDRAILS_DEVICE=cpu
# GUARDRAILS_TORCH_THREADS=2

# GUARDRAILS_BACKEND=remote
# GUARDRAILS_MODEL_URL=http://localhost:8081
# GUARDRAILS_MODEL_API_KEY=dummy-key
# GUARDRAILS_MODEL_TIMEOUT_SECONDS=30

# --- Ambang (R15) -------------------------------------------------------------------------
# Urutan: field `threshold` per request -> endpoint Orkestrasi pusat -> GUARDRAILS_THRESHOLD ->
# nilai yang tersimpan bersama bobot (kunci `decision_threshold` di blur_cnn_meta.json; ekspor
# K2Quality hari ini TIDAK memuatnya) -> 0.5.
#
# Catatan operasional: titik kerja K2Quality sendiri bukan 0.5. `config.yaml`-nya memakai 0.85 dan
# default kodenya 0.62 ("best F1_macro"). Bawaan kontrak 0.5 karenanya lebih galak daripada yang
# dikalibrasi tim ML; setel eksplisit sebelum dipakai sungguhan.
# GUARDRAILS_THRESHOLD=
# Ambang milik Orkestrasi pusat. Endpoint aslinya belum ada; dummy-nya di tracker:
# GUARDRAILS_THRESHOLD_URL=http://127.0.0.1:8090
# GUARDRAILS_THRESHOLD_PATH=/v1/thresholds/guardrails
# GUARDRAILS_THRESHOLD_API_KEY=
# GUARDRAILS_THRESHOLD_TIMEOUT_SECONDS=2
# GUARDRAILS_THRESHOLD_CACHE_SECONDS=60

# --- Masukan ---------------------------------------------------------------------------------
# Tipe dan ukuran (413) dicek orchestrator sebelum guardrails dipanggil. MAX_UPLOAD_BYTES di sini
# hanya membatasi unduhan file_url.
# MAX_UPLOAD_BYTES=5242880
# ALLOWED_CONTENT_TYPES=["image/jpeg","image/png"]

# Jalur PDF dipertahankan tetapi mati bawaan (R34a). Ini SATU-SATUNYA cara memasukkan
# application/pdf; menambahkannya ke ALLOWED_CONTENT_TYPES dengan tangan membuat jalur setengah
# terbuka -- PDF lolos intake lalu gagal lebih dalam. Menyala: halaman 1 dirender 150 DPI, DPI yang
# sama dengan pipeline latih.
# PDF_ENABLED=false

# Saklar unduh `file_url` di guardrails (§13.3, R18a). Kebijakan URL-nya sendiri sudah dipakai
# `read_image` lewat `settings.file_url_policy`; yang ditambahkan di sini hanyalah saklarnya. JANGAN
# menulis kebijakan URL kedua di service ini. Menyala di luar ENVIRONMENT=local mewajibkan
# FILE_URL_ALLOWED_HOSTS terisi, kalau tidak service menolak start.
# GUARDRAILS_FETCH_URL=false
# FILE_URL_ALLOWED_HOSTS=minio.example.internal,.storage.example.com
