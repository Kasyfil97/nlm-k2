API_KEY=changeme

# --- Backend ------------------------------------------------------------------------------
# `kk_regex` adalah parser tata letak K2Regex-v2 yang di-vendor di `app/vendor/`: ia MEMBACA kotak
# OCR dari dokumen yang dikirim. Tidak ada bobot yang perlu diunduh -- templatenya ikut di dalam
# image, jadi `make up` cukup.
#
# `kk_model` adalah model key per kotak m04 (XGBoost bertingkat) + pengelompokan + kosakata tertutup,
# kode di `app/vendor/kk_model/`. Ia PASANGAN trust model `kk_field` di scoring: confidence-nya hanya sah di
# atas structuring ini, jadi ganti keduanya bersama (scoring/training/export_nlm_k2.py menulis keduanya).
# Bobotnya satu berkas; di container diunduh ulang dari STRUCTURING_MODEL_URI setiap start (bukan saat build):
#
#   STRUCTURING_MODEL_URI=<path lokal atau gs://.../kk_structuring_model.joblib> make weights
#
# `mock` MENGARANG satu keluarga sintetis dan mengabaikan seluruh teks OCR: dua kartu berbeda
# kembali identik, dan dokumen yang bukan Kartu Keluarga dijawab 200 dengan KK yang sempurna. Ia
# hanya jalan di ENVIRONMENT=local, dan hanya berguna untuk menggerakkan pipa lewat tuas `MOCK:`
# pada teks OCR (dipakai `make smoke`).
STRUCTURING_BACKEND=kk_model
# STRUCTURING_MODEL_PATH=weights/kk_structuring_model.joblib
STRUCTURING_MODEL_URI=gs://gc-bribrain-dev-gcs-ocr-nilam-01/nilam-ocr-kk/structuring/kk_structuring_model.joblib

ENVIRONMENT=local
# AUTH_DISABLED=false

# SERVICE_BASE_URL=http://your-vm-ip:8043
# PORT=8043


# DATABASE_URL=postgresql+asyncpg://postgres:changeme@localhost:5432/bribrain_ocr_kk

# ORCHESTRATION_URL=http://host.docker.internal:8000
# ORCHESTRATION_CALLBACK_PATH=/v1/callbacks/stage
# ORCHESTRATION_CALLBACK_ENABLED=true
# ORCHESTRATION_CALLBACK_MAX_AGE_SECONDS=600
# ORCHESTRATION_API_KEY=
# ORCHESTRATION_TIMEOUT_SECONDS=10

SCORING_SERVICE_URL=http://127.0.0.1:8044
# SCORING_API_KEY=
# SCORING_TIMEOUT_SECONDS=10

# PIPELINE_RETRY_ATTEMPTS=3
# PIPELINE_RETRY_DELAY_SECONDS=0.5
# PIPELINE_DRAIN_TIMEOUT_SECONDS=30

# --- Ditambahkan fase 0 -------------------------------------------------------------------
# Detak job: memperbarui `updated_at` selagi job berjalan, supaya job yang sah-berjalan-lama tidak
# terlihat basi bagi reaper. `0` = mati, dan itulah bawaan batch ini -- mekanismenya dipasang
# sekarang karena kode pipeline beku setelah gerbang R6, tetapi intervalnya baru bisa disetel
# ketika durasi job sungguhan terukur. Menyalakannya MEWAJIBKAN batas atas di bawahnya.
# PIPELINE_HEARTBEAT_SECONDS=0
# PIPELINE_JOB_MAX_RUNTIME_SECONDS=0

# Serah-terima lewat referensi: tahap berikutnya membaca hasil tahap ini dari database, bukan dari
# badan handoff. Dianjurkan untuk KK -- satu kartu menghasilkan ~177 kotak OCR, dan mode ini
# menjauhkannya dari baris outbox, termasuk dead letter yang bertahan 24 jam.
# PIPELINE_HANDOFF_BY_REFERENCE=true

# Outbox transaksional dan relaynya.
# PIPELINE_OUTBOX=true
# PIPELINE_OUTBOX_INTERVAL_SECONDS=1
# PIPELINE_OUTBOX_MAX_AGE_SECONDS=86400
# PIPELINE_STALE_JOBS=true

# Tabel outcome milik Orkestrasi pusat, di database yang sama. Kontraknya kolom `downstream_status`.
# ORCHESTRATION_OUTCOME_TABLE=orchestration_extract_ocr
# ORCHESTRATION_API_EVENTS_TABLE=

# Endpoint `-test` untuk load test tim ML; menolak menyala di luar ENVIRONMENT=local.
# TESTING_ENDPOINTS=false

# --- Elasticsearch logging ----------------------------------------------------------------
# Kirim setiap log ke Elasticsearch (non-blocking: rekam antri dan dikirim dalam batch oleh
# thread latar). ELASTICSEARCH_ENABLED=false (bawaan) mematikannya tanpa efek apa pun.
# ELASTICSEARCH_ENABLED=false
# ELASTICSEARCH_URL=http://localhost:9200
# ELASTICSEARCH_INDEX=ocr-logs
# Auth (pilih salah satu atau tidak sama sekali):
# ELASTICSEARCH_API_KEY=
# ELASTICSEARCH_USERNAME=
# ELASTICSEARCH_PASSWORD=
