# Dibaca docker compose dari akar repo. Isinya HANYA yang memisahkan satu agen dari agen lain;
# konfigurasi service ada di services/<nama>/.env.
#
# Kenapa ini ada: `container_name` eksplisit tidak di-namespace oleh nama proyek, jadi dulu dua agen
# yang menjalankan stack bersamaan bentrok pada NAMA, bukan hanya port. Nama container sudah dibuang
# dari compose; yang tersisa adalah memberi tiap agen nama proyek dan port host sendiri.
#
# Volume bernama sudah ikut ter-namespace nama proyek (`<project>_postgres-data`), jadi setiap agen
# otomatis punya data Postgres sendiri.

# Agen A: COMPOSE_PROJECT_NAME=nlm-k2-a, lalu port host bawaan.
# Agen B: COMPOSE_PROJECT_NAME=nlm-k2-b, dan geser port host.
# Agen C: COMPOSE_PROJECT_NAME=nlm-k2-c, geser lagi.
COMPOSE_PROJECT_NAME=nlm-k2

# Port DI DALAM jaringan compose tetap 8040-8044: service saling memanggil lewat nama, jadi hanya
# sisi host yang perlu digeser.
# ORCHESTRATOR_HOST_PORT=8040
# GUARDRAILS_HOST_PORT=8041
# EKSTRAKSI_HOST_PORT=8042
# STRUCTURING_HOST_PORT=8043
# SCORING_HOST_PORT=8044
# POSTGRES_HOST_PORT=5433

# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=changeme
# POSTGRES_DB=bribrain_ocr_kk
